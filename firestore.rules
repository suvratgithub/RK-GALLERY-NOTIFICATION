rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             data.alertsEnabled is bool;
    }

    function isValidServiceInquiry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20 &&
             data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 150 &&
             (!('message' in data) || (data.message is string && data.message.size() <= 500)) &&
             data.status in ['OPEN', 'CONTACTED', 'COMPLETED'];
    }

    function isValidSavedBookmark(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 180 &&
             data.categoryTitle is string && data.categoryTitle.size() >= 1 && data.categoryTitle.size() <= 150 &&
             data.itemType in ['SERVICE', 'ALERT'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'alertsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'alertsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'alertsEnabled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /inquiries/{inquiryId} {
        allow get: if isOwner(userId) && isValidId(inquiryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(inquiryId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'OPEN' &&
                         incoming().keys().hasAll(['userId', 'customerName', 'phone', 'serviceName', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'customerName', 'phone', 'serviceName', 'message', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidServiceInquiry(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(inquiryId) &&
                         isValidServiceInquiry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         existing().status != 'COMPLETED' &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['message', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(inquiryId);
      }

      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(bookmarkId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'itemTitle', 'categoryTitle', 'itemType', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'itemTitle', 'categoryTitle', 'itemType', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidSavedBookmark(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(bookmarkId) &&
                         isValidSavedBookmark(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['itemTitle', 'categoryTitle', 'itemType', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }
    }
  }
}
